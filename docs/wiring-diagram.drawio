          <mxGeometry x="680" y="132" width="40" height="36" as="geometry" />
        </mxCell>

        <!-- ===== BAT+ 输出端口（左侧） ===== -->
        <mxCell id="b_batPlus" value="BAT+&#10;(7.4V)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontColor=#B71C1C;fontStyle=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="132" width="90" height="36" as="geometry" />
        </mxCell>

        <!-- BAT− 输出端口（右侧） -->
        <mxCell id="b_batMinus" value="BAT−&#10;(GND)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontColor=#37474F;fontStyle=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="132" width="90" height="36" as="geometry" />
        </mxCell>

        <!-- ===== 连线：BAT+ → 电池盒A正极 ===== -->
        <mxCell id="b_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#C62828;strokeWidth=3;endArrow=none;" edge="1" parent="1" source="b_batPlus" target="b_aPlus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 连线：电池盒A负极 → 电池盒B正极（串联） -->
        <mxCell id="b_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#37474F;strokeWidth=3;endArrow=none;" edge="1" parent="1" source="b_aMinus" target="b_bPlus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 连线：电池盒B负极 → BAT- -->
        <mxCell id="b_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#546E7A;strokeWidth=3;endArrow=none;" edge="1" parent="1" source="b_bMinus" target="b_batMinus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 保护板 ===== -->
        <mxCell id="b_protect" value="18650 3A 过充保护板&#10;过充 / 过放 / 过流保护&#10;B+ ←→ B−　·　P+ 输出 / P− 输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- BAT+ → 保护板 B+ -->
        <mxCell id="b_e4" value="B+" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C62828;strokeWidth=2;endArrow=classic;fontColor=#C62828;fontSize=9;" edge="1" parent="1" source="b_batPlus" target="b_protect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BAT- → 保护板 B- -->
        <mxCell id="b_e5" value="B−" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#546E7A;strokeWidth=2;endArrow=classic;fontColor=#546E7A;fontSize=9;" edge="1" parent="1" source="b_batMinus" target="b_protect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 全车电源轨输出 ===== -->
        <mxCell id="b_power_out" value="→ 全车电源轨&#10;P+ (7.4V 正极)　/　P− (GND 负极)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="295" y="430" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- 保护板 → 全车电源 -->
        <mxCell id="b_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C62828;strokeWidth=2;endArrow=classic;" edge="1" parent="1" source="b_protect" target="b_power_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 接线说明 ===== -->
        <mxCell id="b_note" value="接线说明：&#10;• BAT+ → 保护板 B+&#10;• BAT− → 保护板 B−&#10;• 经保护板后才引出全车电源轨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9F9F9;strokeColor=#BDBDBD;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- ===== 电压规格说明 ===== -->
        <mxCell id="b_spec" value="电压参考：&#10;满电：4.2V × 2 = 8.4V&#10;标称：3.7V × 2 = 7.4V&#10;截止：3.0V × 2 = 6.0V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="180" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
